# 复制为 .env 并填入你的 OpenAI API Key
# cp .env.example .env
OPENAI_API_KEY=

# 她的脑子：填了 ANTHROPIC_API_KEY 就用 Claude（claude-opus-5-5），不填就是 GPT-5。语音转写和朗读仍走 OpenAI
# ANTHROPIC_API_KEY=
# 想点名别的型号才设（比如 claude-sonnet-5-5、gpt-5）
# FRIDAY_MODEL=
# 资料页显示 Anthropic 账单上的准确花费（platform.claude.com/settings/admin-keys 建；这把 key 能管整个组织，只放在云上）
# ANTHROPIC_ADMIN_KEY=

# 语音播报：有 ELEVENLABS_API_KEY 就用 ElevenLabs（更自然）；否则用 OpenAI
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=5VD7EFo2dAP623ZPyqSO
# ELEVENLABS_MODEL=eleven_v4
# FRIDAY_TTS_MODEL=gpt-4o-mini-tts
# FRIDAY_TTS_VOICE=marin
# FRIDAY_TTS_INSTRUCTIONS=

# 用 Cursor 修产品摩擦（可选）。https://cursor.com/dashboard/integrations
# CURSOR_API_KEY=
# CURSOR_AGENT_RUNTIME=auto   # auto | local | cloud；Fly 上默认 cloud
# CURSOR_REPO_URL=https://github.com/MOLIYUANQUAN/FinalYearProject.git
# CURSOR_REPO_REF=develop
# CURSOR_MODEL=composer-2.5
# 云上 Friday 确认部署时用 GitHub 合并（本机有 .git 可不用）
# GITHUB_TOKEN=


# 日历后端：mock（默认）或 google
CALENDAR_BACKEND=mock
GOOGLE_CALENDAR_ID=selected

# 邮件后端：none | mock | gmail | outlook（学校 Azure 常无权限）| imap
MAIL_BACKEND=gmail
# 163 / 126 / QQ 这类邮箱：填地址和授权码（网页版邮箱 → 设置 → POP3/SMTP/IMAP → 开启 IMAP/SMTP → 新增授权密码），
# 填了就读这个邮箱，不用改 MAIL_BACKEND。授权码不是登录密码。
# MAIL_ADDRESS=
# MAIL_PASSWORD=

# 待办后端：none（默认，不出现）| mock | google（先运行 scripts/auth_google_tasks.py）
TASKS_BACKEND=none
# OUTLOOK_CLIENT_ID=
# OUTLOOK_TENANT=organizations

# 手机/云上访问码（空=不启用）。deploy_fly.py / phone_access.py 可自动生成。
# FRIDAY_ACCESS_TOKEN=

# 一个大脑：设了 FRIDAY_URL，Ctrl+Alt+F 打开的就是云上的 Friday（和手机同一个记忆、同一段对话），
# 本机不再起服务。第一次设好后跑一次 scripts/sync_to_cloud.py，把本机记忆并到云上。
# FRIDAY_URL=https://friday-jimmy.fly.dev
# 会变的状态（记忆、对话、摩擦、使用记录）放哪；本机默认 data/，云上 fly.toml 设成 /state
# FRIDAY_STATE_DIR=

# 云上（Fly）会把下面 JSON 落到 secrets/（本地一般不用设）
# GOOGLE_CREDENTIALS_JSON=
# GOOGLE_TOKEN_JSON=
# GMAIL_TOKEN_JSON=
# GOOGLE_TASKS_TOKEN_JSON=

