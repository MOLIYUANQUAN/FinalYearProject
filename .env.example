# 复制为 .env 并填入你的 OpenAI API Key
# cp .env.example .env
OPENAI_API_KEY=

# 日历后端：mock（默认）或 google
CALENDAR_BACKEND=mock
GOOGLE_CALENDAR_ID=selected

# 邮件后端：none | mock | gmail（推荐）| outlook（学校 Azure 常无权限）
MAIL_BACKEND=gmail

# 待办后端：none（默认，不出现）| mock | google（先运行 scripts/auth_google_tasks.py）
TASKS_BACKEND=none
# OUTLOOK_CLIENT_ID=
# OUTLOOK_TENANT=organizations

# 手机从外面进来时的访问码（空=不启用）。跑 scripts/phone_access.py 会自动生成。
# FRIDAY_ACCESS_TOKEN=

